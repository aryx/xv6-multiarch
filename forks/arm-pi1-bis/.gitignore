# Object files
*.ko
*.obj
*.elf

# claude: this port's own build outputs that weren't covered by the
# generic patterns below - build/ (all .o/.d go here per makefile.inc's
# own build-directory rule; *.o/*.d themselves are covered by the
# toplevel .gitignore), disassembly dumps (*.dis - *.asm is covered
# by the toplevel .gitignore too), the raw-binary kernel image (*.img),
# and the host mkfs tool (also a bare binary name; the compiled user
# programs, bare "_name", are covered by the toplevel .gitignore's "_*").
build/
*.dis
*.img
tools/mkfs

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf
