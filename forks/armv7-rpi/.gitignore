# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# claude: this port's own build outputs that weren't covered by the
# generic patterns below - same gap as the sibling armv6-rpi port (see
# that fork's own .gitignore) - build/, disassembly dumps (*.asm/*.dis -
# kernel.dis was actually TRACKED before this fix, a stale ~400KB
# checked-in build artifact), the raw-binary kernel image (*.img), the
# compiled user programs (bare "_name", xv6's own convention), and the
# host mkfs tool.
build/
*.asm
*.dis
*.img
usr/_*
tools/mkfs

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf
