#!/bin/sh
#config: to debug this script add also '-x' to the set below
set -eu

###############################################################################
# Prelude
###############################################################################
# This script was written by Claude Code, modeled on ~/c--/configure (which
# in turn detects, per backend, the cross toolchain and qemu emulator qc--'s
# own test suite needs - see that script's own header comment for the
# reasoning this one reuses).
#
# The difference here: every forks/<name>/Makefile already has its own
# TOOLPREFIX auto-detect built in (see forks/riscv64/Makefile's own
# "Try to infer the correct TOOLPREFIX" block) - so unlike qc--'s test
# scripts, "make -C forks/riscv64 qemu" does not actually NEED this script to
# find a working build. What it's missing, and what this script adds:
#
#  1. An upfront, one-place report of what's missing for a given arch,
#     instead of discovering it deep inside a Makefile's $(shell ...)
#     probe (whose errors are easy to miss).
#  2. A candidate toolchain prefix each fork's own probe doesn't know
#     about but that's what's actually packaged for this host (e.g.
#     i686-linux-gnu- for forks/i386 - Ubuntu ships no i386-jos-elf-
#     package at all, and forks/i386/Makefile's own probe only tries
#     i386-jos-elf- or bare/native, never i686-linux-gnu-).
#  3. Detection of qemu-system-<arch> (the FULL-SYSTEM emulator that boots
#     the compiled kernel image) - not the same thing as qemu-user's
#     per-arch "qemu-<arch>" user-mode binaries (see ~/c--/configure's own
#     RUN_<ARCH> detection): xv6 is a freestanding kernel, not a Linux
#     binary, so it needs a full virtual machine (RAM, UART, disk/virtio),
#     not user-mode syscall translation.
#
# Naming: arch names here are the bare ISA (riscv64, i386, ...), matching
# ~/goken/include/arch/ and ~/c--'s CC<ARCH>/RUN_<ARCH> convention. For
# most ports this still differs from the forks/<name> directory name,
# which instead names the upstream repo/port originally - those
# directories are deliberately NOT renamed to match the bare ISA name:
# that's the factorization phase's job (docs/claude_notes/
# factorization-plan.md), not this one's, and renaming them now would
# break the blame-preserving history that phase depends on. forks/riscv,
# forks/x86, forks/rv32, forks/aarch64, and forks/armv7-rpi were the
# single-fork-per-ISA exception: renamed to forks/riscv64/forks/i386/
# forks/riscv32/forks/arm64/forks/arm outright, each because it's the
# single, unambiguous fork for that ISA/name - true from the start for
# the first four; true for forks/arm only once it beat the other three
# ARM32 candidates and was promoted (2026-09-08, see this script's own
# "arm" section below and root README's port table).
#
# A SECOND, different kind of rename, also done 2026-09-08 (see this
# repo's own top-level Makefile header comment for the full reasoning):
# forks/rpi1, forks/rpi2, forks/armv6-rpi, forks/pi_mp, forks/rpi4, and
# forks/x86_64 were renamed to forks/arm-pi1, forks/arm-pi2,
# forks/arm-pi1-bis, forks/arm-pi3, forks/arm64-pi4, and
# forks/amd64-jserv - an ISA-PREFIXED GROUPING, not a single-ISA-
# representative promotion (each still has its own separate official
# representative: forks/arm, forks/arm64, forks/amd64). Done ahead of
# the factorization phase to make related forks sort together, while
# keeping them genuinely distinct builds - forks/arm-pi1 and
# forks/arm-pi1-bis target the literal same real board (arm-pi1-bis is
# a genuine fork/continuation of arm-pi1's own upstream, not an
# independent implementation - see docs/provenance.md). forks/pi_mp
# joined "arm", not "arm64", despite its own
# upstream README saying "AArch64" - its Makefile only ever builds
# 32-bit ARM code (arm-none-eabi-), real Pi 3 MP hardware in AArch32
# compatibility mode on its ARMv8 chip, not a 64-bit kernel (caught and
# corrected 2026-09-08 from an initial, wrong forks/arm64-pi3 rename).
# See docs/provenance.md for the upstream-repo -> current-forks-path
# mapping table.
#
# Scope: riscv64, i386, amd64-jserv, amd64, riscv32, arm64, mips,
# loongarch, arm-pi1-bis, arm, arm-pi1, and arm-pi2 so far - Phases 1, 2
# and (the start of) 4 of docs/claude_notes/build-and-test-plan.md - see
# docs/claude_notes/notes_arch_*.txt for each arch's own bring-up.

###############################################################################
# Entry point
###############################################################################

TOOLPREFIX_RISCV64=${TOOLPREFIX_RISCV64:-}
QEMU_RISCV64=${QEMU_RISCV64:-}
TOOLPREFIX_I386=${TOOLPREFIX_I386:-}
QEMU_I386=${QEMU_I386:-}
TOOLPREFIX_AMD64_JSERV=${TOOLPREFIX_AMD64_JSERV:-}
QEMU_AMD64_JSERV=${QEMU_AMD64_JSERV:-}
TOOLPREFIX_AMD64=${TOOLPREFIX_AMD64:-}
QEMU_AMD64=${QEMU_AMD64:-}
TOOLPREFIX_RISCV32=${TOOLPREFIX_RISCV32:-}
QEMU_RISCV32=${QEMU_RISCV32:-}
TOOLPREFIX_ARM64=${TOOLPREFIX_ARM64:-}
QEMU_ARM64=${QEMU_ARM64:-}
TOOLPREFIX_MIPS=${TOOLPREFIX_MIPS:-}
QEMU_MIPS=${QEMU_MIPS:-}
TOOLPREFIX_LOONGARCH=${TOOLPREFIX_LOONGARCH:-}
CC_LOONGARCH=${CC_LOONGARCH:-}
QEMU_LOONGARCH=${QEMU_LOONGARCH:-}
TOOLPREFIX_ARM_PI1_BIS=${TOOLPREFIX_ARM_PI1_BIS:-}
QEMU_ARM_PI1_BIS=${QEMU_ARM_PI1_BIS:-}
TOOLPREFIX_ARM=${TOOLPREFIX_ARM:-}
QEMU_ARM=${QEMU_ARM:-}
TOOLPREFIX_ARM_PI1=${TOOLPREFIX_ARM_PI1:-}
QEMU_ARM_PI1=${QEMU_ARM_PI1:-}
TOOLPREFIX_ARM_PI2=${TOOLPREFIX_ARM_PI2:-}
QEMU_ARM_PI2=${QEMU_ARM_PI2:-}
TOOLPREFIX_ARM_PI3=${TOOLPREFIX_ARM_PI3:-}
QEMU_ARM_PI3=${QEMU_ARM_PI3:-}
TOOLPREFIX_ARM64_PI4=${TOOLPREFIX_ARM64_PI4:-}
QEMU_ARM64_PI4=${QEMU_ARM64_PI4:-}

for arg in "$@"; do
    case "$arg" in
        --toolprefix-riscv64=*) TOOLPREFIX_RISCV64="${arg#--toolprefix-riscv64=}" ;;
        --qemu-riscv64=*)       QEMU_RISCV64="${arg#--qemu-riscv64=}" ;;
        --toolprefix-i386=*)    TOOLPREFIX_I386="${arg#--toolprefix-i386=}" ;;
        --qemu-i386=*)          QEMU_I386="${arg#--qemu-i386=}" ;;
        --toolprefix-amd64-jserv=*) TOOLPREFIX_AMD64_JSERV="${arg#--toolprefix-amd64-jserv=}" ;;
        --qemu-amd64-jserv=*)   QEMU_AMD64_JSERV="${arg#--qemu-amd64-jserv=}" ;;
        --toolprefix-amd64=*)   TOOLPREFIX_AMD64="${arg#--toolprefix-amd64=}" ;;
        --qemu-amd64=*)         QEMU_AMD64="${arg#--qemu-amd64=}" ;;
        --toolprefix-riscv32=*) TOOLPREFIX_RISCV32="${arg#--toolprefix-riscv32=}" ;;
        --qemu-riscv32=*)       QEMU_RISCV32="${arg#--qemu-riscv32=}" ;;
        --toolprefix-arm64=*)   TOOLPREFIX_ARM64="${arg#--toolprefix-arm64=}" ;;
        --qemu-arm64=*)         QEMU_ARM64="${arg#--qemu-arm64=}" ;;
        --toolprefix-mips=*)    TOOLPREFIX_MIPS="${arg#--toolprefix-mips=}" ;;
        --qemu-mips=*)          QEMU_MIPS="${arg#--qemu-mips=}" ;;
        --toolprefix-loongarch=*) TOOLPREFIX_LOONGARCH="${arg#--toolprefix-loongarch=}" ;;
        --cc-loongarch=*)       CC_LOONGARCH="${arg#--cc-loongarch=}" ;;
        --qemu-loongarch=*)     QEMU_LOONGARCH="${arg#--qemu-loongarch=}" ;;
        --toolprefix-arm-pi1-bis=*) TOOLPREFIX_ARM_PI1_BIS="${arg#--toolprefix-arm-pi1-bis=}" ;;
        --qemu-arm-pi1-bis=*)   QEMU_ARM_PI1_BIS="${arg#--qemu-arm-pi1-bis=}" ;;
        --toolprefix-arm=*)     TOOLPREFIX_ARM="${arg#--toolprefix-arm=}" ;;
        --qemu-arm=*)           QEMU_ARM="${arg#--qemu-arm=}" ;;
        --toolprefix-arm-pi1=*) TOOLPREFIX_ARM_PI1="${arg#--toolprefix-arm-pi1=}" ;;
        --qemu-arm-pi1=*)       QEMU_ARM_PI1="${arg#--qemu-arm-pi1=}" ;;
        --toolprefix-arm-pi2=*) TOOLPREFIX_ARM_PI2="${arg#--toolprefix-arm-pi2=}" ;;
        --qemu-arm-pi2=*)       QEMU_ARM_PI2="${arg#--qemu-arm-pi2=}" ;;
        --toolprefix-arm-pi3=*) TOOLPREFIX_ARM_PI3="${arg#--toolprefix-arm-pi3=}" ;;
        --qemu-arm-pi3=*)       QEMU_ARM_PI3="${arg#--qemu-arm-pi3=}" ;;
        --toolprefix-arm64-pi4=*) TOOLPREFIX_ARM64_PI4="${arg#--toolprefix-arm64-pi4=}" ;;
        --qemu-arm64-pi4=*)     QEMU_ARM64_PI4="${arg#--qemu-arm64-pi4=}" ;;
        --help|-h)
            echo "Usage: ./configure [options]"
            echo "  --toolprefix-riscv64=PREFIX  override the riscv64 cross-toolchain prefix"
            echo "                               (e.g. riscv64-unknown-elf-)"
            echo "  --qemu-riscv64=CMD           override the riscv64 qemu-system binary"
            echo "  --toolprefix-i386=PREFIX     override the i386 cross-toolchain prefix"
            echo "                               (e.g. i686-linux-gnu-)"
            echo "  --qemu-i386=CMD              override the i386 qemu-system binary"
            echo "  --toolprefix-amd64-jserv=PREFIX override the amd64-jserv cross-toolchain"
            echo "                               prefix (e.g. x86_64-linux-gnu-)"
            echo "  --qemu-amd64-jserv=CMD       override the amd64-jserv qemu-system binary"
            echo "  --toolprefix-amd64=PREFIX    override the amd64 cross-toolchain prefix"
            echo "                               (e.g. x86_64-linux-gnu-)"
            echo "  --qemu-amd64=CMD             override the amd64 qemu-system binary"
            echo "  --toolprefix-riscv32=PREFIX  override the riscv32 cross-toolchain prefix"
            echo "                               (e.g. riscv64-unknown-elf-, multilib)"
            echo "  --qemu-riscv32=CMD           override the riscv32 qemu-system binary"
            echo "  --toolprefix-arm64=PREFIX    override the arm64 cross-toolchain prefix"
            echo "                               (e.g. aarch64-linux-gnu-)"
            echo "  --qemu-arm64=CMD             override the arm64 qemu-system binary"
            echo "  --toolprefix-mips=PREFIX     override the mips cross-toolchain prefix"
            echo "                               (e.g. mipsel-linux-gnu-)"
            echo "  --qemu-mips=CMD              override the mips qemu-system binary"
            echo "  --toolprefix-loongarch=PREFIX override the loongarch cross-toolchain prefix"
            echo "                               (e.g. loongarch64-linux-gnu-)"
            echo "  --cc-loongarch=CMD           override the loongarch gcc binary (this"
            echo "                               toolchain ships a version-suffixed gcc"
            echo "                               only, e.g. loongarch64-linux-gnu-gcc-14)"
            echo "  --qemu-loongarch=CMD         override the loongarch qemu-system binary"
            echo "  --toolprefix-arm-pi1-bis=PREFIX override the arm-pi1-bis cross-toolchain"
            echo "                               prefix (e.g. arm-linux-gnueabihf-)"
            echo "  --qemu-arm-pi1-bis=CMD       override the arm-pi1-bis qemu-system binary"
            echo "  --toolprefix-arm=PREFIX      override the arm (forks/arm) cross-toolchain"
            echo "                               prefix (e.g. arm-linux-gnueabihf-)"
            echo "  --qemu-arm=CMD               override the arm qemu-system binary"
            echo "  --toolprefix-arm-pi1=PREFIX  override the arm-pi1 cross-toolchain prefix"
            echo "                               (e.g. arm-linux-gnueabihf-)"
            echo "  --qemu-arm-pi1=CMD           override the arm-pi1 qemu-system binary"
            echo "  --toolprefix-arm-pi2=PREFIX  override the arm-pi2 cross-toolchain prefix"
            echo "                               (e.g. arm-linux-gnueabihf-)"
            echo "  --qemu-arm-pi2=CMD           override the arm-pi2 qemu-system binary"
            echo "  --toolprefix-arm-pi3=PREFIX  override the arm-pi3 cross-toolchain prefix"
            echo "                               (e.g. arm-linux-gnueabihf-)"
            echo "  --qemu-arm-pi3=CMD           override the arm-pi3 qemu-system binary"
            echo "                               (qemu-system-aarch64 - this fork's own"
            echo "                               Makefile targets -M raspi3b, not raspi2b)"
            echo "  --toolprefix-arm64-pi4=PREFIX override the arm64-pi4 cross-toolchain"
            echo "                               prefix (e.g. aarch64-linux-gnu-)"
            echo "  --qemu-arm64-pi4=CMD         override the arm64-pi4 qemu-system binary"
            echo "                               (qemu-system-aarch64 >= 9.1, the first"
            echo "                               release with a -M raspi4b board at all)"
            echo "TOOLPREFIX_<ARCH>/QEMU_<ARCH> may also be set in the environment."
            exit 0
            ;;
        *)
            echo "Unknown option: $arg" >&2
            echo "Try: ./configure --help" >&2
            exit 1
            ;;
    esac
done

# Printed once total, not once per missing piece - see ~/c--/configure's
# own note_other_pkgmgr for why.
PKGMGR_HINTED=no
note_other_pkgmgr() {
    if [ "$PKGMGR_HINTED" = no ]; then
        echo "  (other distros/OSes: look for the equivalent packages in your own" >&2
        echo "  package manager, e.g. pacman/dnf/brew)" >&2
        PKGMGR_HINTED=yes
    fi
}

###############################################################################
# detect_toolprefix: probe a list of candidate TOOLPREFIX values via each
# candidate's own "<prefix>objdump -i", the same mechanism every
# forks/<name>/Makefile already uses for its own auto-detect - so this
# script's choice, when it finds one, is always something that fork's
# Makefile would also accept, just found here first so the gap is
# reported up front instead of deep inside a $(shell ...) probe.
###############################################################################
# arg1 = display name (for messages), arg2 = variable name to set,
# arg3 = objdump -i marker regex to grep for, arg4.. = candidate prefixes
# to try in order (an empty string "" means "native, no prefix").
# Sets $arg2 to the found prefix, or NONE; returns 1 if none found (the
# caller prints its own tailored apt-hint, since the right package differs
# per arch).
detect_toolprefix() {
    name=$1; varname=$2; marker=$3
    shift 3
    eval "val=\${$varname}"
    if [ -z "$val" ]; then
        for prefix in "$@"; do
            if "${prefix}objdump" -i 2>&1 | grep -q "$marker" 2>/dev/null; then
                val=$prefix
                break
            fi
        done
    fi
    if [ -n "$val" ]; then
        echo "configure: found ${val}gcc ($name)"
        eval "$varname=\$val"
        return 0
    else
        eval "$varname=NONE"
        return 1
    fi
}

###############################################################################
# detect_versioned_gcc: find the actual gcc binary for a given TOOLPREFIX,
# for toolchains where "<prefix>gcc" itself doesn't exist. Every other
# arch's cross-gcc package in this script ships an unversioned "<prefix>gcc"
# (a symlink/alias to whichever gcc-N is default), which is why
# detect_toolprefix above can get away with assuming "${val}gcc" works.
# Debian/Ubuntu's gcc-N-loongarch64-linux-gnu package does not: it installs
# only "loongarch64-linux-gnu-gcc-14" (or whatever N is current), no plain
# "loongarch64-linux-gnu-gcc" - see notes_arch_loongarch.txt. Try the plain
# name first anyway (works if some future package does provide one, or if
# this ever runs natively on loongarch64 hardware), then fall back to
# probing versioned suffixes, newest first.
###############################################################################
# arg1 = display name, arg2 = variable name to set, arg3 = TOOLPREFIX value
# to build the candidate binary names from. Sets $arg2 to the found gcc
# binary name, or NONE; returns 1 if none found.
detect_versioned_gcc() {
    name=$1; varname=$2; prefix=$3
    eval "val=\${$varname}"
    if [ -z "$val" ]; then
        if command -v "${prefix}gcc" >/dev/null 2>&1; then
            val="${prefix}gcc"
        else
            for v in 16 15 14 13 12 11 10 9; do
                if command -v "${prefix}gcc-$v" >/dev/null 2>&1; then
                    val="${prefix}gcc-$v"
                    break
                fi
            done
        fi
    fi
    if [ -n "${val:-}" ]; then
        echo "configure: found $val ($name)"
        eval "$varname=\$val"
        return 0
    else
        eval "$varname=NONE"
        return 1
    fi
}

###############################################################################
# detect_qemu_system: find a full-system qemu-system-<arch> binary and,
# optionally, enforce a minimum version - in pure shell arithmetic, not
# sed -E/bc (see docs/claude_notes/notes_arch_riscv64.txt's own "PATH
# hazard" section for why: a host can have a same-named tool earlier on
# PATH that silently does the wrong thing, e.g. this box's ~/goken build
# used to shadow the real GNU sed/bc with its own minimal ones - found the
# hard way while writing the first version of this check).
###############################################################################
# arg1 = display name, arg2 = variable name to set, arg3 = qemu-system-*
# binary name to look for, arg4 = min major version (or "" to skip the
# version check entirely - not every fork's Makefile enforces one),
# arg5 = min minor version (required if arg4 is given).
# Sets $arg2 to the found binary's path, or NONE; returns 1 on any failure.
detect_qemu_system() {
    name=$1; varname=$2; qbin=$3; minmajor=${4:-}; minminor=${5:-}
    eval "val=\${$varname}"
    if [ -z "$val" ]; then
        val=`command -v "$qbin" 2>/dev/null || true`
    fi
    if [ -z "$val" ] || ! command -v "$val" >/dev/null 2>&1; then
        eval "$varname=NONE"
        return 1
    fi
    if [ -n "$minmajor" ]; then
        version_line=`"$val" --version | head -n 1`
        # "QEMU emulator version 8.2.2 (Debian ...)" -> "8.2.2" -> 8, 2
        qversion=${version_line#*version }
        qversion=${qversion%% *}
        qmajor=${qversion%%.*}
        qminor_rest=${qversion#*.}
        qminor=${qminor_rest%%.*}
        if [ "$qmajor" -gt "$minmajor" ] 2>/dev/null || \
           { [ "$qmajor" -eq "$minmajor" ] && [ "$qminor" -ge "$minminor" ]; } 2>/dev/null; then
            echo "configure: found $val, version $qversion ($name)"
        else
            echo "configure: warning: $val is version $qversion, need >= $minmajor.$minminor" >&2
            eval "$varname=NONE"
            return 1
        fi
    else
        echo "configure: found $val ($name)"
    fi
    eval "$varname=\$val"
    return 0
}

###############################################################################
# riscv64 (forks/riscv64, RV64GC - MIT's current xv6-riscv)
###############################################################################

if ! detect_toolprefix riscv64 TOOLPREFIX_RISCV64 elf64-big \
        riscv64-unknown-elf- riscv64-elf- riscv64-none-elf- \
        riscv64-linux-gnu- riscv64-unknown-linux-gnu-; then
    echo "configure: warning: no riscv64 toolchain on PATH (needed for forks/riscv64)" >&2
    echo "  install one, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install gcc-riscv64-unknown-elf" >&2
    echo "  or:" >&2
    echo "    sudo apt install gcc-riscv64-linux-gnu" >&2
    note_other_pkgmgr
fi

# forks/riscv64/Makefile hardcodes QEMU = qemu-system-riscv64 and separately
# enforces MIN_QEMU_VERSION = 7.2 via its own check-qemu-version target
# (which shells out to `bc`) - reproducing that same floor here means a
# too-old qemu is reported by ./configure, not by a cryptic failure deep
# inside "make qemu".
if ! detect_qemu_system riscv64 QEMU_RISCV64 qemu-system-riscv64 7 2; then
    echo "configure: warning: no working qemu-system-riscv64 on PATH" >&2
    echo "  install it, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install qemu-system-misc" >&2
    echo "  (qemu-system-misc bundles the FULL-SYSTEM emulators for the" >&2
    echo "  less-common targets - riscv, mips, loongarch, m68k, sparc,..." >&2
    echo "  distinct from qemu-user's per-arch user-mode binaries)" >&2
    note_other_pkgmgr
fi
if [ "$QEMU_RISCV64" != NONE ] && ! command -v bc >/dev/null 2>&1; then
    echo "configure: warning: 'bc' not on PATH" >&2
    echo "  forks/riscv64/Makefile's own check-qemu-version target (a" >&2
    echo "  dependency of its 'qemu' target) needs it regardless of the" >&2
    echo "  check ./configure just did:" >&2
    echo "    sudo apt install bc" >&2
fi

###############################################################################
# i386 (forks/i386, MIT xv6-public - the original teaching OS)
###############################################################################
# i386-jos-elf- is the classic toolchain name this port's own README
# expects; i686-linux-gnu- is what Ubuntu/Debian actually package (there
# is no i386-jos-elf- package) and what forks/i386/Makefile's own
# auto-detect does NOT know to look for - the reason ./configure earns its
# keep here specifically. Bare "" (native) is tried last, for a real
# 32-bit-or-64-bit x86 Linux host where the host gcc itself emits
# elf32-i386 (e.g. via its own default or -m32 support).

if ! detect_toolprefix i386 TOOLPREFIX_I386 elf32-i386 \
        i386-jos-elf- i686-linux-gnu- ''; then
    echo "configure: warning: no i386 toolchain on PATH (needed for forks/i386)" >&2
    echo "  install one, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install gcc-i686-linux-gnu libc6-dev-i386-cross" >&2
    note_other_pkgmgr
fi

# forks/i386/Makefile enforces no minimum QEMU version of its own.
if ! detect_qemu_system i386 QEMU_I386 qemu-system-i386; then
    echo "configure: warning: no qemu-system-i386 on PATH" >&2
    echo "  install it, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install qemu-system-x86" >&2
    note_other_pkgmgr
fi

###############################################################################
# amd64-jserv (forks/amd64-jserv, jserv/xv6-x86_64 - renamed from
# forks/x86_64, grouped under the "amd64" ISA prefix alongside the
# unrelated forks/amd64 below - see this repo's own Makefile header
# comment on this rename)
###############################################################################
# forks/amd64-jserv/Makefile has no TOOLPREFIX-style auto-detect at all -
# it uses "CROSS_COMPILE ?=" (empty default, i.e. assumes native) and
# "QEMU ?= qemu-system-x86_64" - so on this (or any non-x86_64) host it
# would otherwise fall back to trying the HOST's own gcc as an x86_64
# compiler, silently wrong rather than a clear error. Passed to that
# fork's Makefile as CROSS_COMPILE=$(TOOLPREFIX_AMD64_JSERV), not
# TOOLPREFIX=... - see the top-level Makefile's own build-amd64-jserv
# target.

if ! detect_toolprefix amd64-jserv TOOLPREFIX_AMD64_JSERV elf64-x86-64 \
        x86_64-linux-gnu- x86_64-elf- ''; then
    echo "configure: warning: no x86_64 toolchain on PATH (needed for forks/amd64-jserv)" >&2
    echo "  install one, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install gcc-x86-64-linux-gnu" >&2
    note_other_pkgmgr
fi

# forks/amd64-jserv/Makefile enforces no minimum QEMU version of its own.
if ! detect_qemu_system amd64-jserv QEMU_AMD64_JSERV qemu-system-x86_64; then
    echo "configure: warning: no qemu-system-x86_64 on PATH" >&2
    echo "  install it, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install qemu-system-x86" >&2
    note_other_pkgmgr
fi

###############################################################################
# amd64 (forks/amd64, MIT's own abandoned 2018 x86-64 experiment)
###############################################################################
# forks/amd64/Makefile DOES have a TOOLPREFIX auto-detect (copy-pasted
# from forks/i386's own i386 one, per its identical structure), but it
# still probes for the 32-bit "elf32-i386" objdump marker even though
# this fork builds a 64-bit kernel (-m64 -mcmodel=large) - an apparent
# leftover from that copy-paste, never updated for 64-bit. Left
# untouched (not this repo's fork to "fix" just for that), but it means
# the auto-detect will never actually find a real 64-bit toolchain on
# its own; passing TOOLPREFIX explicitly (as this script's own
# detection does, correctly checking elf64-x86-64) bypasses it entirely
# via the same ifndef guard every other TOOLPREFIX-based fork honors.

if ! detect_toolprefix amd64 TOOLPREFIX_AMD64 elf64-x86-64 \
        x86_64-linux-gnu- x86_64-elf- ''; then
    echo "configure: warning: no amd64 toolchain on PATH (needed for forks/amd64)" >&2
    echo "  install one, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install gcc-x86-64-linux-gnu" >&2
    note_other_pkgmgr
fi

# forks/amd64/Makefile enforces no minimum QEMU version of its own.
if ! detect_qemu_system amd64 QEMU_AMD64 qemu-system-x86_64; then
    echo "configure: warning: no qemu-system-x86_64 on PATH" >&2
    echo "  install it, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install qemu-system-x86" >&2
    note_other_pkgmgr
fi

###############################################################################
# riscv32 (forks/riscv32, michaelengel/xv6-rv32)
###############################################################################
# Ubuntu ships no dedicated riscv32-unknown-elf- package at all - the
# riscv64-unknown-elf- toolchain (already needed for riscv64 above) is
# multilib and happily targets rv32 given explicit -march/-mabi flags
# (forks/riscv32/Makefile's own CFLAGS already carries these - see
# docs/claude_notes/notes_arch_riscv32.txt), so it's tried here as a
# fallback candidate after the (currently nonexistent-on-Debian/Ubuntu)
# dedicated 32-bit names. Marker is "elf32-littleriscv" specifically,
# not riscv64's own "elf64-big" - a multilib toolchain's objdump lists
# both, so this confirms 32-bit ELF support rather than just "some kind
# of riscv toolchain".

if ! detect_toolprefix riscv32 TOOLPREFIX_RISCV32 elf32-littleriscv \
        riscv32-unknown-elf- riscv32-elf- riscv32-linux-gnu- \
        riscv64-unknown-elf- riscv64-elf- riscv64-linux-gnu-; then
    echo "configure: warning: no riscv32-capable toolchain on PATH (needed for forks/riscv32)" >&2
    echo "  install one, e.g. on Debian/Ubuntu (multilib, covers riscv64 too):" >&2
    echo "    sudo apt install gcc-riscv64-unknown-elf" >&2
    note_other_pkgmgr
fi

# forks/riscv32/Makefile enforces no minimum QEMU version of its own.
if ! detect_qemu_system riscv32 QEMU_RISCV32 qemu-system-riscv32; then
    echo "configure: warning: no qemu-system-riscv32 on PATH" >&2
    echo "  install it, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install qemu-system-misc" >&2
    note_other_pkgmgr
fi

###############################################################################
# arm64 (forks/arm64, k-mrm/xv6-aarch64)
###############################################################################
# No gaps here - aarch64-linux-gnu-gcc and qemu-system-aarch64 are both
# already what Ubuntu packages, and the fork's own (copy-pasted, generic)
# TOOLPREFIX auto-detect already tries aarch64-linux-gnu- as a candidate.
# This detection exists mainly for the same up-front-report and
# consistency reasons every other arch here has it, not because this one
# needed any real gap-filling.

if ! detect_toolprefix arm64 TOOLPREFIX_ARM64 elf64-big \
        aarch64-unknown-elf- aarch64-linux-gnu- aarch64-unknown-linux-gnu-; then
    echo "configure: warning: no arm64 toolchain on PATH (needed for forks/arm64)" >&2
    echo "  install one, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install gcc-aarch64-linux-gnu" >&2
    note_other_pkgmgr
fi

# forks/arm64/Makefile enforces no minimum QEMU version of its own.
if ! detect_qemu_system arm64 QEMU_ARM64 qemu-system-aarch64; then
    echo "configure: warning: no qemu-system-aarch64 on PATH" >&2
    echo "  install it, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install qemu-system-arm" >&2
    note_other_pkgmgr
fi

###############################################################################
# mips (forks/mips, nullpo-head/xv6-mips)
###############################################################################
# mipsel, not mips: this fork targets little-endian MIPS (its own
# Makefile's default TOOLPREFIX is mipsel-sde-elf-, and kernel.ld's own
# OUTPUT_FORMAT is "elf32-tradlittlemips") - matching ~/c--'s own CCMIPS
# ("32-bit mipsel C compiler") naming, which is "mips" as the bare
# backend name despite being little-endian under the hood. Marker is
# elf32-tradlittlemips specifically (not just "mips"), to confirm the
# little-endian variant rather than a big-endian-only toolchain.

if ! detect_toolprefix mips TOOLPREFIX_MIPS elf32-tradlittlemips \
        mipsel-linux-gnu- mipsel-sde-elf- mipsel-unknown-elf-; then
    echo "configure: warning: no mipsel toolchain on PATH (needed for forks/mips)" >&2
    echo "  install one, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install gcc-mipsel-linux-gnu" >&2
    note_other_pkgmgr
fi

# forks/mips/Makefile enforces no minimum QEMU version of its own. Note:
# qemu-system-mips is a SEPARATE apt package from qemu-system-misc
# (which covers riscv64/riscv32) - see notes_arch_mips.txt.
if ! detect_qemu_system mips QEMU_MIPS qemu-system-mipsel; then
    echo "configure: warning: no qemu-system-mipsel on PATH" >&2
    echo "  install it, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install qemu-system-mips" >&2
    note_other_pkgmgr
fi

###############################################################################
# loongarch (forks/loongarch, SKT-CPUOS/xv6-loongarch-exp)
###############################################################################
# Marker is elf64-loongarch (this port is 64-bit-only, no 32-bit variant
# to disambiguate against the way mips's marker had to).

if ! detect_toolprefix loongarch TOOLPREFIX_LOONGARCH elf64-loongarch \
        loongarch64-linux-gnu- loongarch64-unknown-linux-gnu-; then
    echo "configure: warning: no loongarch64 toolchain on PATH (needed for forks/loongarch)" >&2
    echo "  install one, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install gcc-14-loongarch64-linux-gnu" >&2
    note_other_pkgmgr
fi

# See detect_versioned_gcc's own header comment: this toolchain's gcc is
# version-suffixed only, so forks/loongarch/Makefile's own plain
# "$(TOOLPREFIX)gcc" needs a separate, explicit CC override - passed
# through as CC_LOONGARCH (see build-loongarch in the top-level Makefile).
if [ "$TOOLPREFIX_LOONGARCH" != NONE ]; then
    if ! detect_versioned_gcc loongarch CC_LOONGARCH "$TOOLPREFIX_LOONGARCH"; then
        echo "configure: warning: found $TOOLPREFIX_LOONGARCH toolchain but no matching gcc binary" >&2
        note_other_pkgmgr
    fi
else
    CC_LOONGARCH=NONE
fi

# forks/loongarch/Makefile enforces no minimum QEMU version of its own.
# qemu-system-loongarch64 is bundled in the qemu-system-misc apt package
# (same as riscv64/riscv32/mips) - no separate package needed.
if ! detect_qemu_system loongarch QEMU_LOONGARCH qemu-system-loongarch64; then
    echo "configure: warning: no qemu-system-loongarch64 on PATH" >&2
    echo "  install it, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install qemu-system-misc" >&2
    note_other_pkgmgr
fi

###############################################################################
# arm-pi1-bis (forks/arm-pi1-bis, inaciose/xv6-armv6-rpi - renamed from
# forks/armv6-rpi)
###############################################################################
# Not a bare ISA name like every other arch above - there's no single
# natural "arm32" bare name to give it (unlike riscv32/riscv64 or arm64,
# ~/c--'s own convention only has ONE generic 32-bit ARM backend, "arm",
# and this repo has FOUR real ARMv6/ARMv7 32-bit ports - forks/arm-pi1-bis,
# forks/arm, forks/arm-pi1, forks/arm-pi2). forks/arm (formerly
# forks/armv7-rpi) has since claimed the bare "arm" name below and been
# renamed to match, once it became the clear winner (the only one
# reaching a genuinely interactive shell with a passing usertests run) -
# arm-pi1-bis/arm-pi1/arm-pi2 keep their own ISA-prefixed names, grouped
# under "arm" for the eventual factorization merge but not collapsed
# into it, since they remain genuinely distinct real-hardware builds
# (see this script's own header comment and this repo's Makefile header
# comment on this rename).

if ! detect_toolprefix arm-pi1-bis TOOLPREFIX_ARM_PI1_BIS elf32-littlearm \
        arm-linux-gnueabihf- arm-none-eabi- arm-linux-gnueabi-; then
    echo "configure: warning: no arm toolchain on PATH (needed for forks/arm-pi1-bis)" >&2
    echo "  install one, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install gcc-arm-linux-gnueabihf" >&2
    note_other_pkgmgr
fi

# forks/arm-pi1-bis/Makefile enforces no minimum QEMU version of its own.
# qemu-system-arm is bundled in the qemu-system-arm apt package (a
# SEPARATE package from qemu-system-misc, which covers riscv/mips/
# loongarch above).
if ! detect_qemu_system arm-pi1-bis QEMU_ARM_PI1_BIS qemu-system-arm; then
    echo "configure: warning: no qemu-system-arm on PATH" >&2
    echo "  install it, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install qemu-system-arm" >&2
    note_other_pkgmgr
fi

###############################################################################
# arm (forks/arm, inaciose/xv6-armv7-rpi - renamed from forks/armv7-rpi)
###############################################################################
# This is the only one of the four ARM32 ports here that boots to a
# genuinely interactive shell and passes its own usertests (see
# notes_arch_arm.txt) - so unlike arm-pi1-bis above, it earned the bare
# "arm" name outright, matching ~/c--'s/~/goken's own generic 32-bit ARM
# backend convention (same reasoning as the arm64 section above, just
# resolved later once there was an actual winner among the four
# candidates), and its directory was renamed forks/armv7-rpi ->
# forks/arm to match (2026-09-08).
if ! detect_toolprefix arm TOOLPREFIX_ARM elf32-littlearm \
        arm-linux-gnueabihf- arm-none-eabi- arm-linux-gnueabi-; then
    echo "configure: warning: no arm toolchain on PATH (needed for forks/arm)" >&2
    echo "  install one, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install gcc-arm-linux-gnueabihf" >&2
    note_other_pkgmgr
fi

if ! detect_qemu_system arm QEMU_ARM qemu-system-arm; then
    echo "configure: warning: no qemu-system-arm on PATH" >&2
    echo "  install it, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install qemu-system-arm" >&2
    note_other_pkgmgr
fi

###############################################################################
# arm-pi1 (forks/arm-pi1, zhiyihuang/xv6_rpi_port - renamed from forks/rpi1)
###############################################################################
# ISA-prefixed name, no ambiguity within its own board target (unlike
# arm-pi1-bis/arm above, which target the same real board or compete for
# the ISA-representative slot) - only one zhiyihuang-lineage Raspberry
# Pi 1 port in this repo.
#
# claude: this fork genuinely boots on real Raspberry Pi 1 hardware (the
# user has one) - TOOLPREFIX_ARM_PI1/QEMU_ARM_PI1 here only feed the
# ADDITIVE QEMU-only "kernel-qemu.img"/"qemu" Makefile targets (see
# notes_arch_arm_pi1.txt), never the real-hardware "kernel.img"/"all"
# targets, which stay reachable only via the fork's own Makefile
# directly (this repo's top-level build system is specifically about
# QEMU-based build/boot, per CLAUDE.md).

if ! detect_toolprefix arm-pi1 TOOLPREFIX_ARM_PI1 elf32-littlearm \
        arm-linux-gnueabihf- arm-none-eabi- arm-linux-gnueabi-; then
    echo "configure: warning: no arm toolchain on PATH (needed for forks/arm-pi1)" >&2
    echo "  install one, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install gcc-arm-linux-gnueabihf" >&2
    note_other_pkgmgr
fi

# forks/arm-pi1/Makefile enforces no minimum QEMU version of its own.
if ! detect_qemu_system arm-pi1 QEMU_ARM_PI1 qemu-system-arm; then
    echo "configure: warning: no qemu-system-arm on PATH" >&2
    echo "  install it, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install qemu-system-arm" >&2
    note_other_pkgmgr
fi

###############################################################################
# arm-pi2 (forks/arm-pi2, zhiyihuang/xv6_rpi_port, extended to ARMv7/rpi2 -
# renamed from forks/rpi2)
###############################################################################
# ISA-prefixed name, same reasoning as arm-pi1 above - only one
# zhiyihuang-lineage Raspberry Pi 2 port in this repo.
#
# claude: this fork genuinely boots on real Raspberry Pi 2 hardware (the
# user has one) - TOOLPREFIX_ARM_PI2/QEMU_ARM_PI2 here only feed the
# ADDITIVE QEMU-only "kernel7-qemu.bin"/"qemu" Makefile targets (see
# notes_arch_arm_pi2.txt), never the real-hardware "kernel7.bin"/"all"
# targets, which stay reachable only via the fork's own Makefile
# directly - same reasoning as arm-pi1 above.

if ! detect_toolprefix arm-pi2 TOOLPREFIX_ARM_PI2 elf32-littlearm \
        arm-linux-gnueabihf- arm-none-eabi- arm-linux-gnueabi-; then
    echo "configure: warning: no arm toolchain on PATH (needed for forks/arm-pi2)" >&2
    echo "  install one, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install gcc-arm-linux-gnueabihf" >&2
    note_other_pkgmgr
fi

# forks/arm-pi2/Makefile enforces no minimum QEMU version of its own.
if ! detect_qemu_system arm-pi2 QEMU_ARM_PI2 qemu-system-arm; then
    echo "configure: warning: no qemu-system-arm on PATH" >&2
    echo "  install it, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install qemu-system-arm" >&2
    note_other_pkgmgr
fi

###############################################################################
# arm-pi3 (forks/arm-pi3, patha454/xv6_pi_mp - renamed from forks/pi_mp)
###############################################################################
# claude: real Raspberry Pi 3 MP hardware (32-bit ARM despite the
# upstream README's "AArch64" description - see this repo's own
# CLAUDE.md). Unlike arm-pi1/arm-pi2, this fork's QEMU path needed a
# genuine, separate armstub (armstub64.S) and targets qemu-system-
# aarch64 -M raspi3b (not qemu-system-arm) - raspi3b's Cortex-A53 always
# resets in AArch64, and QEMU's raw "-kernel"/"-device loader" loaders
# skip the AArch64->AArch32 firmware step real GPU firmware normally
# does, so this fork's own Makefile supplies it (see that Makefile's
# and armstub64.S's own comments for the full story, and
# notes_arch_arm_pi3.txt for everything found getting here). Still not
# fully working (a real SMP page-table race crashes a secondary core
# deep into boot - see that notes file) - TOOLPREFIX_ARM_PI3/
# QEMU_ARM_PI3 only feed the ADDITIVE QEMU-only "kernel7-qemu.bin"/
# "armstub64.bin"/"qemu" Makefile targets, never the real-hardware
# "kernel7.bin"/"all" ones.

if ! detect_toolprefix arm-pi3 TOOLPREFIX_ARM_PI3 elf32-littlearm \
        arm-linux-gnueabihf- arm-none-eabi- arm-linux-gnueabi-; then
    echo "configure: warning: no arm toolchain on PATH (needed for forks/arm-pi3)" >&2
    echo "  install one, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install gcc-arm-linux-gnueabihf" >&2
    note_other_pkgmgr
fi

# forks/arm-pi3/Makefile's own armstub64.bin rule needs an AArch64
# toolchain too (QEMU_AARCH64_TOOLPREFIX, defaulted to
# aarch64-linux-gnu- in that Makefile already) - reuses whatever the
# arm64 section above already found (TOOLPREFIX_ARM64) rather than
# detecting it a second time.
if ! detect_qemu_system arm-pi3 QEMU_ARM_PI3 qemu-system-aarch64; then
    echo "configure: warning: no qemu-system-aarch64 on PATH" >&2
    echo "  install it, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install qemu-system-arm" >&2
    note_other_pkgmgr
fi

###############################################################################
# arm64-pi4 (forks/arm64-pi4, k-mrm/xv6-rpi4 - renamed from forks/rpi4)
###############################################################################
# claude: real Raspberry Pi 4B AArch64 hardware - upstream's own README
# says the port is "confirmed on an actual Raspberry Pi 4B", and unlike
# forks/arm-pi3 (32-bit despite its own README) this one really is a
# 64-bit kernel, hence the "arm64" prefix.
#
# The asymmetry worth knowing here: the TOOLCHAIN is fine on this host,
# the EMULATOR is not. forks/arm64-pi4 builds cleanly today (two narrow
# -Wno- flags, see notes_arch_arm64_pi4.txt), but qemu only grew a
# Raspberry Pi 4 board at all in 9.1 ("-M raspi4b"); this host is on
# 8.2.2, whose newest raspi board is raspi3b. So the version floor below
# is not a nice-to-have - below 9.1 there is simply nothing to boot on.
# That is why the top-level Makefile splits this arch's checks in two:
# "build-arm64-pi4" needs only TOOLPREFIX_ARM64_PI4 and works now,
# "run-arm64-pi4" additionally needs QEMU_ARM64_PI4 and does not.
#
# (Upstream developed the port against k-mrm's own qemu fork,
# qemu-patch-raspberry4, whose board is spelled "raspi4b1g" - still the
# default in forks/arm64-pi4/Makefile. It is not detected here: it is a
# hand-built tree at an arbitrary path, not something on PATH. Point
# this at it by hand with --qemu-arm64-pi4=<path>/qemu-system-aarch64
# plus QEMUMACHINE=raspi4b1g if you have one.)

if ! detect_toolprefix arm64-pi4 TOOLPREFIX_ARM64_PI4 elf64-big \
        aarch64-linux-gnu- aarch64-unknown-elf- aarch64-none-elf- \
        aarch64-elf- aarch64-unknown-linux-gnu-; then
    echo "configure: warning: no aarch64 toolchain on PATH (needed for forks/arm64-pi4)" >&2
    echo "  install one, e.g. on Debian/Ubuntu:" >&2
    echo "    sudo apt install gcc-aarch64-linux-gnu" >&2
    note_other_pkgmgr
fi

if ! detect_qemu_system arm64-pi4 QEMU_ARM64_PI4 qemu-system-aarch64 9 1; then
    echo "configure: warning: no qemu-system-aarch64 >= 9.1 on PATH" >&2
    echo "  9.1 is the first release with a Raspberry Pi 4 board (-M raspi4b)" >&2
    echo "  at all - older ones stop at raspi3b, so there is no machine for" >&2
    echo "  forks/arm64-pi4's kernel to boot on. 'make build-arm64-pi4' still" >&2
    echo "  works without it; 'make run-arm64-pi4' does not." >&2
    echo "  on Debian/Ubuntu that means a distro new enough to package it:" >&2
    echo "    sudo apt install qemu-system-arm" >&2
    note_other_pkgmgr
fi

###############################################################################
# Write Makefile.config
###############################################################################
# "export VAR=value", not a plain assignment: the top-level Makefile
# "-include"s this file, and GNU Make's "export" both sets the variable
# there AND re-exports it into every recipe's shell - same reasoning as
# ~/c--/configure's own Makefile.config header comment.

{
    echo "# generated by ./configure - do not edit, re-run configure instead"
    echo
    echo "# riscv64 (forks/riscv64, RV64GC - MIT xv6-riscv)"
    echo "export TOOLPREFIX_RISCV64=$TOOLPREFIX_RISCV64"
    echo "export QEMU_RISCV64=$QEMU_RISCV64"
    echo
    echo "# i386 (forks/i386 - MIT xv6-public)"
    echo "export TOOLPREFIX_I386=$TOOLPREFIX_I386"
    echo "export QEMU_I386=$QEMU_I386"
    echo
    echo "# amd64-jserv (forks/amd64-jserv - jserv/xv6-x86_64, renamed from forks/x86_64)"
    echo "export TOOLPREFIX_AMD64_JSERV=$TOOLPREFIX_AMD64_JSERV"
    echo "export QEMU_AMD64_JSERV=$QEMU_AMD64_JSERV"
    echo
    echo "# amd64 (forks/amd64 - MIT's own abandoned 2018 x86-64 experiment)"
    echo "export TOOLPREFIX_AMD64=$TOOLPREFIX_AMD64"
    echo "export QEMU_AMD64=$QEMU_AMD64"
    echo
    echo "# riscv32 (forks/riscv32 - michaelengel/xv6-rv32)"
    echo "export TOOLPREFIX_RISCV32=$TOOLPREFIX_RISCV32"
    echo "export QEMU_RISCV32=$QEMU_RISCV32"
    echo
    echo "# arm64 (forks/arm64 - k-mrm/xv6-aarch64)"
    echo "export TOOLPREFIX_ARM64=$TOOLPREFIX_ARM64"
    echo "export QEMU_ARM64=$QEMU_ARM64"
    echo
    echo "# mips (forks/mips - nullpo-head/xv6-mips)"
    echo "export TOOLPREFIX_MIPS=$TOOLPREFIX_MIPS"
    echo "export QEMU_MIPS=$QEMU_MIPS"
    echo
    echo "# loongarch (forks/loongarch - SKT-CPUOS/xv6-loongarch-exp)"
    echo "export TOOLPREFIX_LOONGARCH=$TOOLPREFIX_LOONGARCH"
    echo "export CC_LOONGARCH=$CC_LOONGARCH"
    echo "export QEMU_LOONGARCH=$QEMU_LOONGARCH"
    echo
    echo "# arm-pi1-bis (forks/arm-pi1-bis - inaciose/xv6-armv6-rpi, renamed from forks/armv6-rpi)"
    echo "export TOOLPREFIX_ARM_PI1_BIS=$TOOLPREFIX_ARM_PI1_BIS"
    echo "export QEMU_ARM_PI1_BIS=$QEMU_ARM_PI1_BIS"
    echo
    echo "# arm (forks/arm - inaciose/xv6-armv7-rpi, renamed from forks/armv7-rpi)"
    echo "export TOOLPREFIX_ARM=$TOOLPREFIX_ARM"
    echo "export QEMU_ARM=$QEMU_ARM"
    echo
    echo "# arm-pi1 (forks/arm-pi1 - zhiyihuang/xv6_rpi_port, renamed from forks/rpi1)"
    echo "export TOOLPREFIX_ARM_PI1=$TOOLPREFIX_ARM_PI1"
    echo "export QEMU_ARM_PI1=$QEMU_ARM_PI1"
    echo
    echo "# arm-pi2 (forks/arm-pi2 - zhiyihuang/xv6_rpi_port, extended to rpi2, renamed from forks/rpi2)"
    echo "export TOOLPREFIX_ARM_PI2=$TOOLPREFIX_ARM_PI2"
    echo "export QEMU_ARM_PI2=$QEMU_ARM_PI2"
    echo
    echo "# arm-pi3 (forks/arm-pi3 - patha454/xv6_pi_mp, renamed from forks/pi_mp)"
    echo "export TOOLPREFIX_ARM_PI3=$TOOLPREFIX_ARM_PI3"
    echo "export QEMU_ARM_PI3=$QEMU_ARM_PI3"
    echo
    echo "# arm64-pi4 (forks/arm64-pi4 - k-mrm/xv6-rpi4, renamed from forks/rpi4)"
    echo "export TOOLPREFIX_ARM64_PI4=$TOOLPREFIX_ARM64_PI4"
    echo "export QEMU_ARM64_PI4=$QEMU_ARM64_PI4"
} > Makefile.config

echo "wrote Makefile.config"
echo "  TOOLPREFIX_RISCV64      = $TOOLPREFIX_RISCV64"
echo "  QEMU_RISCV64            = $QEMU_RISCV64"
echo "  TOOLPREFIX_I386         = $TOOLPREFIX_I386"
echo "  QEMU_I386               = $QEMU_I386"
echo "  TOOLPREFIX_AMD64_JSERV  = $TOOLPREFIX_AMD64_JSERV"
echo "  QEMU_AMD64_JSERV        = $QEMU_AMD64_JSERV"
echo "  TOOLPREFIX_AMD64        = $TOOLPREFIX_AMD64"
echo "  QEMU_AMD64              = $QEMU_AMD64"
echo "  TOOLPREFIX_RISCV32      = $TOOLPREFIX_RISCV32"
echo "  QEMU_RISCV32            = $QEMU_RISCV32"
echo "  TOOLPREFIX_ARM64        = $TOOLPREFIX_ARM64"
echo "  QEMU_ARM64              = $QEMU_ARM64"
echo "  TOOLPREFIX_MIPS         = $TOOLPREFIX_MIPS"
echo "  QEMU_MIPS               = $QEMU_MIPS"
echo "  TOOLPREFIX_LOONGARCH    = $TOOLPREFIX_LOONGARCH"
echo "  CC_LOONGARCH            = $CC_LOONGARCH"
echo "  QEMU_LOONGARCH          = $QEMU_LOONGARCH"
echo "  TOOLPREFIX_ARM_PI1_BIS  = $TOOLPREFIX_ARM_PI1_BIS"
echo "  QEMU_ARM_PI1_BIS        = $QEMU_ARM_PI1_BIS"
echo "  TOOLPREFIX_ARM          = $TOOLPREFIX_ARM"
echo "  QEMU_ARM                = $QEMU_ARM"
echo "  TOOLPREFIX_ARM_PI1      = $TOOLPREFIX_ARM_PI1"
echo "  QEMU_ARM_PI1            = $QEMU_ARM_PI1"
echo "  TOOLPREFIX_ARM_PI2      = $TOOLPREFIX_ARM_PI2"
